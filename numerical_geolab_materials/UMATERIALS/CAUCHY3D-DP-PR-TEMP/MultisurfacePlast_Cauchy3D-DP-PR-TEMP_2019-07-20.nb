Cell[BoxData[{
 StyleBox[
  RowBox[{
   RowBox[{"n", "=", "3"}], ";"}],
  FontColor->GrayLevel[0]], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   StyleBox["sym\[Sigma]",
    FontColor->GrayLevel[0]], 
   StyleBox["=",
    FontColor->GrayLevel[0]], 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      SubscriptBox["x_", 
       RowBox[{"2", ",", "1"}]], "\[Rule]", 
      SubscriptBox["x", 
       RowBox[{"1", ",", "2"}]]}], ",", 
     RowBox[{
      SubscriptBox["x_", 
       RowBox[{"3", ",", "1"}]], "\[Rule]", 
      SubscriptBox["x", 
       RowBox[{"1", ",", "3"}]]}], ",", 
     RowBox[{
      SubscriptBox["x_", 
       RowBox[{"3", ",", "2"}]], "\[Rule]", 
      SubscriptBox["x", 
       RowBox[{"2", ",", "3"}]]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sym\[CurlyEpsilon]", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[CurlyEpsilon]el", 
       RowBox[{"1", ",", "2"}]], "\[Rule]", 
      RowBox[{
       FractionBox["1", "2"], 
       SubscriptBox["\[Gamma]el", 
        RowBox[{"1", ",", "2"}]]}]}], ",", 
     RowBox[{
      SubscriptBox["\[CurlyEpsilon]el", 
       RowBox[{"2", ",", "1"}]], "\[Rule]", 
      RowBox[{
       FractionBox["1", "2"], 
       SubscriptBox["\[Gamma]el", 
        RowBox[{"1", ",", "2"}]]}]}], ",", 
     RowBox[{
      SubscriptBox["\[CurlyEpsilon]el", 
       RowBox[{"1", ",", "3"}]], "\[Rule]", 
      RowBox[{
       FractionBox["1", "2"], 
       SubscriptBox["\[Gamma]el", 
        RowBox[{"1", ",", "3"}]]}]}], ",", 
     RowBox[{
      SubscriptBox["\[CurlyEpsilon]el", 
       RowBox[{"3", ",", "1"}]], "\[Rule]", 
      RowBox[{
       FractionBox["1", "2"], 
       SubscriptBox["\[Gamma]el", 
        RowBox[{"1", ",", "3"}]]}]}], ",", 
     RowBox[{
      SubscriptBox["\[CurlyEpsilon]el", 
       RowBox[{"2", ",", "3"}]], "\[Rule]", 
      RowBox[{
       FractionBox["1", "2"], 
       SubscriptBox["\[Gamma]el", 
        RowBox[{"2", ",", "3"}]]}]}], ",", 
     RowBox[{
      SubscriptBox["\[CurlyEpsilon]el", 
       RowBox[{"3", ",", "2"}]], "\[Rule]", 
      RowBox[{
       FractionBox["1", "2"], 
       SubscriptBox["\[Gamma]el", 
        RowBox[{"2", ",", "3"}]]}]}], ",", 
     RowBox[{
      SubscriptBox["\[CurlyEpsilon]el", 
       RowBox[{"\[Iota]_", ",", "\[Iota]_"}]], "\[Rule]", 
      SubscriptBox["\[Gamma]el", 
       RowBox[{"\[Iota]", ",", "\[Iota]"}]]}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   SubscriptBox["stress", 
    RowBox[{"i_", ",", "j_"}]], ":=", 
   RowBox[{
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       SubscriptBox["CC", 
        RowBox[{"i", ",", "j", ",", "k", ",", "l"}]], 
       SubscriptBox["\[CurlyEpsilon]el", 
        RowBox[{"k", ",", "l"}]]}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "1", ",", "n"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"l", ",", "1", ",", "n"}], "}"}]}], "]"}], "/.", 
    "sym\[CurlyEpsilon]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  SubscriptBox["flux", "i_"], ":=", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{
     SubscriptBox["kk", 
      RowBox[{"i", ",", "j"}]], 
     SubscriptBox["pf", 
      RowBox[{"0", ",", "j"}]]}], ",", 
    RowBox[{"{", 
     RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  SubscriptBox["tflux", "i_"], ":=", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{
     SubscriptBox["tk", 
      RowBox[{"i", ",", "j"}]], 
