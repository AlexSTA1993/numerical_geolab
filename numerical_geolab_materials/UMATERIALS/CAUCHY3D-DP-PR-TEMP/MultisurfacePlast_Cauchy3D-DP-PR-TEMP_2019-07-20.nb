      RowBox[{"0", ",", "j"}]]}], ",", 
    RowBox[{"{", 
     RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"HelmEnergy", "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          SubscriptBox["stress", 
           RowBox[{"i", ",", "i"}]], 
          SubscriptBox["\[Gamma]el", 
           RowBox[{"i", ",", "i"}]]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}], "+", 
       RowBox[{
        SubscriptBox["stress", 
         RowBox[{"1", ",", "2"}]], 
        SubscriptBox["\[Gamma]el", 
         RowBox[{"1", ",", "2"}]]}], "+", 
