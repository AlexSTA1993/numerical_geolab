Cell[BoxData[{
 RowBox[{
  SubscriptBox["CC", 
   RowBox[{"i_", ",", "j_", ",", "k_", ",", "l_"}]], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"\[CapitalKappa]", "-", 
      RowBox[{
       FractionBox["2", "3"], "G"}]}], ")"}], " ", 
    RowBox[{"KroneckerDelta", "[", 
     RowBox[{"i", ",", "j"}], "]"}], 
    RowBox[{"KroneckerDelta", "[", 
     RowBox[{"k", ",", "l"}], "]"}]}], "+", 
   RowBox[{"G", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"KroneckerDelta", "[", 
        RowBox[{"i", ",", "k"}], "]"}], 
       RowBox[{"KroneckerDelta", "[", 
        RowBox[{"j", ",", "l"}], "]"}]}], "+", 
      RowBox[{
       RowBox[{"KroneckerDelta", "[", 
        RowBox[{"i", ",", "l"}], "]"}], 
       RowBox[{"KroneckerDelta", "[", 
        RowBox[{"j", ",", "k"}], "]"}]}]}], 
     ")"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  SubscriptBox["kk", 
   RowBox[{"i_", ",", "j_"}]], ":=", 
  RowBox[{
   FractionBox["\[Kappa]", "\[Eta]"], " ", 
   RowBox[{"KroneckerDelta", "[", 
    RowBox[{"i", ",", "j"}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  SubscriptBox["tk", 
   RowBox[{"i_", ",", "j_"}]], ":=", 
  RowBox[{
   FractionBox["t\[Kappa]", "\[Rho]C"], " ", 
   RowBox[{"KroneckerDelta", "[", 
    RowBox[{"i", ",", "j"}], "]"}]}]}]}], "Input",
 CellChangeTimes->{{3.735457559841067*^9, 3.7354575670504684`*^9}, {
