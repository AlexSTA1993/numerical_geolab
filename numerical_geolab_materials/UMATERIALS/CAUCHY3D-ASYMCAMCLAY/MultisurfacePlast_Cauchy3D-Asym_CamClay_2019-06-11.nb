      RowBox[{
       RowBox[{"KroneckerDelta", "[", 
        RowBox[{"i", ",", "l"}], "]"}], 
       RowBox[{"KroneckerDelta", "[", 
        RowBox[{"j", ",", "k"}], "]"}]}]}], ")"}]}]}]}]], "Input",
