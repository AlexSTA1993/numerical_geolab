Cell[TextData[{
 "\[LineSeparator]The hardening law (HQ) is given in incremental form (",
 Cell[BoxData[
  FormBox[
   SubscriptBox["dq", "i"], TraditionalForm]],ExpressionUUID->
  "46de9c36-48c8-4e4d-bdcb-244717ca0567"],
 "=...) and has to be linear with respect to the Lagrange multipliers. It is \
represented by a matrix that has Nh (=number of hardening variables) lines \
and Nf (=number of failure surfaces) columns. See Jirasec for more details.\n\
Syntax: {{surf1.rule1,surf1.rule2...},{surf2.rule1,surf2.rule2...}...}"
}], "Text",
 CellChangeTimes->{{3.664303389977174*^9, 3.664303466263727*^9}, {
